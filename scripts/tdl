#!/bin/sh
# tdl — offer a file for download through tether (iTerm2 OSC 1337 format).
# Usage: tdl <file>
# Works in any pane: the bytes ride the PTY stream; the tether browser UI
# shows a save chip. Also compatible with iTerm2 itself.
[ $# -eq 1 ] || { echo "usage: tdl <file>" >&2; exit 1; }
[ -f "$1" ] || { echo "not a file: $1" >&2; exit 1; }
name=$(printf %s "$1" | base64 | tr -d '\n')
size=$(wc -c < "$1" | tr -d ' ')
printf '\033]1337;File=name=%s;size=%s:' "$name" "$size"
base64 < "$1"
printf '\007'
